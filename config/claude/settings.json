{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-shell-edits.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-change-writing.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-anthropic-attribution.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-enter-worktree.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remind-mr-description.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remind-review-pass.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-devenv.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "skipWorkflowUsageWarning": true
}
